[Unit]
Description=Mohini LiveKit SIP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mohini-livekit-sip
Group=mohini-livekit-sip
ExecStart=/usr/bin/mohini-livekit-sip --config /etc/mohini-livekit-sip/config.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
