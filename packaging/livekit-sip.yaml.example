# /etc/livekit-sip/config.yaml
api_key: <your-api-key>
api_secret: <your-api-secret>
ws_url: ws://localhost:7880
redis:
  address: localhost:6379
sip_port: 5060
rtp_port: "10000-20000"
logging:
  level: info
# ICE to the SFU: empty = UDP only, fallback = UDP+TCP, force = TCP only
# ice_tcp: fallback
